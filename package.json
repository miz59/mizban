{
  "name": "test",
  "version": "1.0.0",
  "description": "null",
  "type": "module",
  "scripts": {
    "watch-sass": "sass --watch --update --style=expanded sass/style.scss:assets/css/style.css",
    "build-sass": "sass --no-source-map --style=compressed sass/style.scss:assets/css/style.min.css",
    "watch-miz": "concurrently \"sass --watch --update --style=expanded miz/_index.scss:assets/css/miz.min.css\" \"node miz/pkg/merge-components.js --watch\"",
    "build-miz": "concurrently \"sass --no-source-map --style=compressed miz/_index.scss:assets/css/miz.min.css\" \"node miz/pkg/merge-components.js --build\"",
    "build-miz-clean": "sass --no-source-map --style=expanded miz/_index.scss:assets/css/miz-clean.css && node miz/pkg/miz-min.cjs",
    "build-mizban": "node ./assets/vendors/mizban/commands/listFiles.js && node ./assets/vendors/mizban/commands/extractVariables.js",
    "watch-mizban": "concurrently \"sass --watch --update --style=expanded miz/_index.scss:assets/css/miz.min.css\" \"node miz/pkg/watch-all.js --watch\"",
    "dev": "node miz/pkg/server.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.0.0",
    "sass": "^1.75.0",
    "terser": "^5.43.1"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "fs": "^0.0.1-security",
    "multer": "^2.0.2"
  }
}